{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["cli.ts", "lib.ts", "relay.ts", "state.ts", "agent-adapter.ts", "driver.ts", "approvals.ts", "agent-host.ts", "setup.ts", "adapters/**/*.ts", "ledger/**/*.ts", "console-ui.ts", "dm-courier.ts", "tests/**/*.ts"]
}
